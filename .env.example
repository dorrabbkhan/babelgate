PORT=3000

TARGET_API=

UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_RETRIES=1
MAX_BODY_SIZE=10mb

# Client-facing auth — when set, callers must send the key in their SDK's
# native auth header (Authorization: Bearer, x-api-key, x-goog-api-key or
# ?key=). Leave unset for local dev.
# PROXY_API_KEY=

OPENAI_API_KEY=
OPENAI_API_BASE_URL=

GEMINI_API_KEY=
GEMINI_API_BASE_URL=

OLLAMA_API_KEY=
OLLAMA_API_BASE_URL=http://localhost:11434

ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=

# Responses-native upstream (TARGET_API=responses)
RESPONSES_API_KEY=
RESPONSES_API_BASE_URL=

# Longest gap allowed between upstream stream chunks (ms)
UPSTREAM_STREAM_IDLE_MS=300000

# URL media (v1.5 spec §3.2.2): whether the proxy fetches media URLs a
# target can't take by URL, and whether private-range addresses may be
# fetched. Caps are fixed at 20 MB and 15 s.
MEDIA_FETCH=true
MEDIA_ALLOW_PRIVATE=false
