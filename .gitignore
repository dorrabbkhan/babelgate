# Compiled JavaScript and TypeScript output
/dist/
*.js
# Keep TypeScript declaration files if you publish a package
!/src/**/*.d.ts
# Keep the Claude Code gate fixture's plain .js files
!/scripts/gates/fixtures/**

# Node.js dependencies
/node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
.env.*.local
# Keep the example file in version control
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by testing tools
/coverage/
.nyc_output/

# Editor/IDE specific files
# VS Code settings (optional, you might want to share some)
.vscode/
# IntelliJ IDEA settings
.idea/
# macOS specific files
.DS_Store
# Windows specific files
Thumbs.db

# npm package manager specific
.npm/
.yarn-integrity
.yarnrc

# Yarn Plug'n'Play (if you use Yarn 2+)
.pnp.js
.pnp.*.cjs

# TypeScript specific
# TypeScript build info file for incremental builds
*.tsbuildinfo

# Optional: if you have any temporary or generated files
tmp/
*.tmp
*.bak
*.swp
*.swo

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Output of 'npm pack'
*.tgz

# Cache
.cache/

# Custom additions for your project
# If you create any other temporary files or directories during development,
# add them here. For example:
# /temp_data/
# /test_results/

# UI toolchain artifacts: vitest's optimizer cache and the
# Playwright smoke-test output (scripts/ci/ui-smoke.sh)
ui/node_modules/
ui/test-results/
ui/playwright-report/

# Agent tooling: shared config is tracked, local state is not
.claude/settings.local.json
.claude/worktrees/
.claude/ms-playwright/
.claude/ui-shots/
.devin/config.local.json
.taskmaster
.windsurf
.gemini
GEMINI.md