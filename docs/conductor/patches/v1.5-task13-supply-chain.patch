diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index ecb0076..da6d7d1 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -6,8 +6,9 @@ on:
     tags: ['v*']
 
 permissions:
-  contents: read
+  id-token: write
   packages: write
+  contents: write
 
 jobs:
   # Packed-install smoke test (1.1.1 hotfix): the tagged commit must start
@@ -29,6 +30,10 @@ jobs:
   docker:
     needs: smoke-pack
     runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      packages: write
+      id-token: write # cosign keyless signing uses the job's OIDC token
     steps:
       - name: Checkout
         uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
@@ -48,6 +53,7 @@ jobs:
         run: echo "version=${GITHUB_REF_NAME#v}" >> "$GITHUB_OUTPUT"
 
       - name: Build and push image
+        id: build
         uses: docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8 # v6.19.2
         with:
           context: .
@@ -55,3 +61,84 @@ jobs:
           tags: |
             ghcr.io/dorrabbkhan/babelgate:${{ steps.image.outputs.version }}
             ghcr.io/dorrabbkhan/babelgate:latest
+
+      - name: Install cosign
+        uses: sigstore/cosign-installer@756fe2d284c7292c4e9b62c8a28f1e5629c59532 # v4.1.3
+
+      # Keyless: Fulcio issues a short-lived certificate from the job's
+      # OIDC token (identity = this workflow on the release tag) and the
+      # signature is logged in Rekor. The matching `cosign verify`
+      # command is in SECURITY.md.
+      - name: Sign the pushed image (keyless)
+        run: cosign sign --yes ghcr.io/dorrabbkhan/babelgate@${{ steps.build.outputs.digest }}
+
+  # npm publish with provenance (spec §3.5): --provenance mints a Sigstore
+  # bundle tying the tarball to this repository and the release tag,
+  # verified client-side with `npm audit signatures`. prepublishOnly runs
+  # ./scripts/check.sh — the same gate a local `npm publish` enforces.
+  npm-publish:
+    needs: smoke-pack
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      id-token: write
+    steps:
+      - name: Checkout
+        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
+
+      - name: Set up Node
+        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
+        with:
+          node-version: 22
+          cache: npm
+          registry-url: https://registry.npmjs.org
+
+      - run: npm ci
+
+      - name: Publish to npm with provenance
+        run: npm publish --provenance --access public
+        env:
+          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
+
+  # GitHub release (spec §3.5): attaches a CycloneDX SBOM of the runtime
+  # dependencies and leads the notes with the runtime dependency count.
+  # Runs only after both artifacts (image and package) are published.
+  release:
+    needs: [docker, npm-publish]
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    steps:
+      - name: Checkout
+        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
+
+      - name: Set up Node
+        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
+        with:
+          node-version: 22
+          cache: npm
+
+      - run: npm ci
+
+      - name: CycloneDX SBOM (runtime dependencies only)
+        run: npm sbom --sbom-format cyclonedx --omit dev > "babelgate-${GITHUB_REF_NAME#v}.cdx.json"
+
+      - name: Build release notes
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          gh api "repos/${GITHUB_REPOSITORY}/releases/generate-notes" \
+            -f tag_name="${GITHUB_REF_NAME}" --jq .body > generated-notes.md || true
+          deps=$(npm ls --omit=dev --all --parseable | tail -n +2 | wc -l)
+          {
+            echo "Runtime dependencies: ${deps}"
+            echo ""
+            echo "SBOM (CycloneDX): \`babelgate-${GITHUB_REF_NAME#v}.cdx.json\`, attached to this release."
+            echo ""
+            cat generated-notes.md
+          } > release-notes.md
+
+      - name: Create the GitHub release and attach the SBOM
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: gh release create "${GITHUB_REF_NAME}" --title "${GITHUB_REF_NAME}" --notes-file release-notes.md "babelgate-${GITHUB_REF_NAME#v}.cdx.json"
