+
+  # Weekly (Mon 06:00 UTC) client-release replay (v1.5 spec §3.4): the
+  # latest Claude Code and Codex releases run the edit-task gates
+  # through babelgate on a cheap OpenRouter model and their request
+  # shapes are diffed against the committed recording fixtures. Any
+  # failure or added shape opens a `client-replay` issue — a new
+  # client release can change its wire shape without breaking the
+  # edit task, and the compatibility matrix's badge reads this job's
+  # schedule runs. workflow_dispatch is included so the job can be
+  # verified after the patch lands without waiting for Monday.
+  client-replay:
+    if: github.event.schedule == '0 6 * * 1' || github.event_name == 'workflow_dispatch'
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      issues: write
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+      - run: npm ci
+      - name: Replay the latest client releases
+        env:
+          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
+        run: scripts/gates/client-replay.sh
+      - name: Open a client-replay issue on failure
+        if: failure()
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          gh label create client-replay \
+            --description "Weekly client-release replay failures" \
+            --color BFD4F2 --force
+          mkdir -p tmp/client-replay
+          summary=tmp/client-replay/summary.md
+          if [ ! -f "$summary" ]; then
+            echo "client-replay.sh exited before writing a summary — see the job log." > "$summary"
+          fi
+          if gh issue list --label client-replay --state open --limit 1 --json number --jq '.[0].number' | grep -q .; then
+            echo "an open client-replay issue already exists — not creating another"
+          else
+            gh issue create --label client-replay \
+              --title "Client replay failed: $(cat tmp/client-replay/versions.txt 2>/dev/null || echo 'versions unknown')" \
+              --body-file "$summary"
+          fi
